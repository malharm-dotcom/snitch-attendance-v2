generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Supervisor {
  id             Int      @id @default(autoincrement())
  supervisorName String   @map("supervisor_name") @db.VarChar(200)
  employeeCode   String?  @unique @map("employee_code") @db.VarChar(50)
  facility       String   @db.VarChar(50)
  department     String   @db.VarChar(100)
  departments    String[]
  pin            String   @db.VarChar(10)
  passwordHash   String?  @map("password_hash") @db.Text
  role           String   @default("supervisor") @db.VarChar(20)
  allFacilities  Boolean  @default(false) @map("all_facilities")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("supervisors")
}

model Employee {
  id               Int      @id @default(autoincrement())
  employeeCode     String   @unique @map("employee_code") @db.VarChar(50)
  employeeName     String   @map("employee_name") @db.VarChar(200)
  facility         String   @db.VarChar(50)
  department       String   @db.VarChar(100)
  shift            String?  @db.VarChar(10)
  designation      String?  @db.VarChar(100)
  reportingManager String?  @map("reporting_manager") @db.VarChar(200)
  rollType         String?   @map("roll_type") @db.VarChar(20)
  gender           String?   @db.VarChar(10)
  isActive         Boolean   @default(true) @map("is_active")
  joiningDate      DateTime? @map("joining_date") @db.Date
  exitDate         DateTime? @map("exit_date") @db.Date
  loadedAt         DateTime  @default(now()) @map("loaded_at")

  attendanceDetails AttendanceDetail[]
  otRequests        OtRequest[]

  @@map("employees")
}

model AttendanceHeader {
  id             Int      @id @default(autoincrement())
  attendanceDate DateTime @map("attendance_date") @db.Date
  facility       String   @db.VarChar(50)
  department     String   @db.VarChar(100)
  markedBy       String   @map("marked_by") @db.VarChar(200)
  markedAt       DateTime @map("marked_at") @db.Timestamp(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  status         String   @default("submitted") @db.VarChar(20)
  shift          String?  @db.VarChar(10)

  details AttendanceDetail[]

  @@map("attendance_header")
}

model AttendanceDetail {
  id               Int      @id @default(autoincrement())
  headerId         Int      @map("attendance_header_id")
  employeeId       Int?     @map("employee_id")
  employeeCode     String   @map("employee_code") @db.VarChar(50)
  employeeName     String   @map("employee_name") @db.VarChar(200)
  attendanceStatus String   @map("attendance_status") @db.VarChar(50)
  remarks          String?  @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  attendanceDate   DateTime? @map("attendance_date") @db.Date

  header   AttendanceHeader @relation(fields: [headerId], references: [id])
  employee Employee?        @relation(fields: [employeeCode], references: [employeeCode])

  @@map("attendance_detail")
}

model AttendanceRewriteRequest {
  id             Int       @id @default(autoincrement())
  attendanceDate DateTime  @map("attendance_date") @db.Date
  facility       String    @db.VarChar(50)
  department     String    @db.VarChar(100)
  employeeCode   String?   @map("employee_code") @db.VarChar(50)
  supervisorName String    @map("supervisor_name") @db.VarChar(200)
  reason         String    @db.Text
  requestStatus  String    @default("pending") @map("request_status") @db.VarChar(20)
  requestedAt    DateTime  @map("requested_at") @db.Timestamp(6)
  actionedBy     String?   @map("actioned_by") @db.VarChar(200)
  actionedAt     DateTime? @map("actioned_at") @db.Timestamp(6)

  @@map("attendance_rewrite_requests")
}

// Overtime ledger — DELIBERATELY SEPARATE from attendance.
//
// OT is never written into attendance_detail.attendance_status: a day can be Present
// AND carry OT hours, and mixing the two would corrupt every attendance count and the
// LOP calculation. Single-level Manager approval, parallel to AttendanceRewriteRequest.

model OtRequest {
  id              Int       @id @default(autoincrement())
  employeeCode    String    @map("employee_code") @db.VarChar(50)
  /// Stamped SERVER-SIDE from the session. Never accepted from the client.
  facility        String    @db.VarChar(50)
  /// Calendar date — plain YYYY-MM-DD, never timezone-shifted.
  otDate          DateTime  @map("ot_date") @db.Date
  /// Half-hour steps; the 0.5 step and the 0 < h <= 24 range are enforced by CHECK.
  otHours         Decimal   @map("ot_hours") @db.Decimal(4, 2)
  reason          String    @db.Text
  /// 'Pending' | 'Approved' | 'Rejected' — enforced by CHECK.
  status          String    @default("Pending") @db.VarChar(20)
  requestedBy     String    @map("requested_by") @db.VarChar(200)
  approvedBy      String?   @map("approved_by") @db.VarChar(200)
  /// An instant, not a calendar date — timestamptz, stored UTC.
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(6)
  rejectionReason String?   @map("rejection_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeCode], references: [employeeCode])

  @@index([facility, status])
  @@index([employeeCode, otDate])
  @@map("ot_requests")
}
